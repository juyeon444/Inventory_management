#!/usr/bin/expect

set venv_path ".venv/bin/activate"

set program "source $venv_path; python main.py"
spawn bash -c "$program"

# Function to wait for a prompt and send input
proc send_input {prompt input} {
    expect $prompt
    send "$input\r"
    sleep 1
}

# Function to navigate to User Management
proc go_to_user_management {} {
    expect "Enter your choice:"
    send "1\r"
    sleep 1
}

# Function to navigate to Admin Management
proc go_to_admin_management {} {
    expect "Enter your choice:"
    send "2\r"
    sleep 1
}

# Function to navigate to Inventory Management
proc go_to_inventory_management {} {
    expect "Enter your choice:"
    send "3\r"
    sleep 1
}

# Function to navigate to Order Management
proc go_to_order_management {} {
    expect "Enter your choice:"
    send "4\r"
    sleep 1
}

